@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap');

/* ─── Design Tokens ─────────────────────────────────────── */
:root {
  /* Backgrounds — warm obsidian, not cold navy */
  --bg:      #0b0b0a;
  --surf:    #131312;
  --card:    #191917;
  --card2:   #1f1f1d;
  --hover:   #242422;
  --inp:     #0e0e0d;

  /* Borders */
  --b1: rgba(255,255,255,0.06);
  --b2: rgba(255,255,255,0.10);
  --b3: rgba(255,255,255,0.16);

  /* Primary — coral/tomato, bold & distinctive */
  --co:    #ff4d2e;
  --co-l:  #ff6b4f;
  --co-d:  #e63f22;
  --co-dim:rgba(255,77,46,0.12);
  --co-glo:rgba(255,77,46,0.28);

  /* Secondary accents */
  --mint:    #00c9a7;
  --mint-d:  rgba(0,201,167,0.12);
  --gold:    #f0a500;
  --gold-d:  rgba(240,165,0,0.12);
  --sky:     #38b6ff;
  --sky-d:   rgba(56,182,255,0.12);
  --rose:    #ff3d6b;
  --rose-d:  rgba(255,61,107,0.12);

  /* Text */
  --t1: #f5f5f4;
  --t2: #a8a49e;
  --t3: #57534e;
  --t4: #292524;

  /* Layout */
  --sb:    252px;
  --sb-sm: 60px;

  /* Radii */
  --r1: 6px; --r2: 10px; --r3: 14px; --r4: 20px;

  /* Transition */
  --d: 0.15s ease;
}

/* ─── Reset ────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: 'DM Sans', system-ui, sans-serif;
  background: var(--bg); color: var(--t1);
  font-size: 14px; line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
button { font-family: inherit; cursor: pointer; background: none; border: none; }
input, select, textarea { font-family: inherit; }
a { color: var(--co); text-decoration: none; }
a:hover { opacity: .8; }
.hidden { display: none !important; }

/* ═══════════════════════════════════════════════
   AUTH SCREEN  — position:fixed guarantees centering
═══════════════════════════════════════════════ */
.auth-screen {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem 1.5rem;
  background: var(--bg);
  z-index: 200;
  overflow-y: auto;
}

/* Dot grid background */
.auth-screen::before {
  content: '';
  position: fixed; inset: 0; z-index: 0; pointer-events: none;
  background-image: radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 28px 28px;
}

.auth-wrap {
  position: relative; z-index: 1;
  display: grid; grid-template-columns: 420px 1fr;
  max-width: 900px; width: 100%; min-height: 540px;
  background: var(--card);
  border: 1px solid var(--b1);
  border-radius: var(--r4);
  box-shadow: 0 40px 100px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.03);
  overflow: hidden;
  flex-shrink: 0;
}

/* Brand panel */
.auth-brand {
  padding: 3.25rem 2.75rem;
  background: var(--card2);
  border-right: 1px solid var(--b1);
  display: flex; flex-direction: column; justify-content: center; gap: 1.6rem;
  position: relative; overflow: hidden;
}

/* Coral corner accent */
.auth-brand::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: linear-gradient(90deg, var(--co), var(--co-l), transparent);
}

.brand-logo {
  display: flex; align-items: center; gap: .7rem;
  font-family: 'Syne', sans-serif; font-size: 1.3rem; font-weight: 800;
  color: var(--t1); letter-spacing: -.02em;
}
.brand-logo i { color: var(--co); font-size: 1.3rem; }

.auth-brand h1 {
  font-family: 'Syne', sans-serif;
  font-size: 2rem; font-weight: 800; line-height: 1.18; color: var(--t1);
  letter-spacing: -.03em;
}
.auth-brand h1 em {
  font-style: normal; color: var(--co);
}
.auth-brand > p { font-size: .875rem; color: var(--t2); line-height: 1.78; }

.brand-feats { list-style: none; display: flex; flex-direction: column; gap: .55rem; }
.brand-feats li {
  display: flex; align-items: center; gap: .6rem;
  font-size: .82rem; color: var(--t2);
}
.brand-feats li i { color: var(--mint); font-size: .72rem; }

/* Decorative number */
.brand-deco {
  position: absolute; bottom: -20px; right: -10px;
  font-family: 'Syne', sans-serif; font-size: 9rem; font-weight: 800;
  color: rgba(255,77,46,0.04); line-height: 1; pointer-events: none;
  user-select: none;
}

/* Form panel */
.auth-forms {
  padding: 3.25rem 3rem;
  display: flex; flex-direction: column; justify-content: center;
}
.auth-card h2 {
  font-family: 'Syne', sans-serif; font-size: 1.65rem; font-weight: 800;
  color: var(--t1); margin-bottom: .25rem; letter-spacing: -.025em;
}
.auth-sub { font-size: .875rem; color: var(--t2); margin-bottom: 1.75rem; }
.auth-switch { text-align: center; margin-top: 1.25rem; font-size: .82rem; color: var(--t3); }
.auth-switch a { color: var(--co); font-weight: 600; }

/* ═══════════════════════════════════════════════
   APP SCREEN
═══════════════════════════════════════════════ */
.app-screen { display: flex; min-height: 100vh; }

/* Sidebar */
.sidebar {
  width: var(--sb); position: fixed; top: 0; bottom: 0; left: 0;
  background: var(--surf); border-right: 1px solid var(--b1);
  display: flex; flex-direction: column; z-index: 100;
  transition: width var(--d);
}
.sidebar.collapsed { width: var(--sb-sm); }

.sb-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 1.25rem 1rem; border-bottom: 1px solid var(--b1);
  min-height: 64px; overflow: hidden;
}
.sb-logo {
  display: flex; align-items: center; gap: .6rem;
  font-family: 'Syne', sans-serif; font-size: 1.05rem; font-weight: 800;
  color: var(--t1); white-space: nowrap; overflow: hidden; letter-spacing: -.02em;
}
.sb-logo i { color: var(--co); font-size: 1.05rem; flex-shrink: 0; }
.sidebar.collapsed .sb-logo span { display: none; }

.sb-toggle { color: var(--t3); padding: .3rem; border-radius: var(--r1); transition: var(--d); }
.sb-toggle:hover { color: var(--t1); background: var(--hover); }

.sb-nav {
  flex: 1; padding: 1rem .75rem;
  display: flex; flex-direction: column; gap: .15rem; overflow-y: auto;
}

.nav-item {
  display: flex; align-items: center; gap: .65rem;
  padding: .62rem .85rem; border-radius: var(--r2);
  color: var(--t3); font-size: .86rem; font-weight: 500;
  text-decoration: none !important; overflow: hidden; white-space: nowrap;
  transition: background var(--d), color var(--d); position: relative;
}
.nav-item i { width: 16px; text-align: center; font-size: .88rem; flex-shrink: 0; }
.nav-item:hover { color: var(--t1); background: var(--hover); }
.nav-item.active {
  color: var(--co); background: var(--co-dim); font-weight: 600;
}
.nav-item.active::before {
  content: ''; position: absolute; left: 0; top: 20%; bottom: 20%;
  width: 3px; border-radius: 0 3px 3px 0; background: var(--co);
}
.sidebar.collapsed .nav-item { justify-content: center; }
.sidebar.collapsed .nav-item span { display: none; }

.sb-foot {
  padding: .85rem .75rem; border-top: 1px solid var(--b1);
  display: flex; align-items: center; gap: .5rem; overflow: hidden;
}
.sb-owner { display: flex; align-items: center; gap: .6rem; flex: 1; min-width: 0; overflow: hidden; }
.sb-avatar {
  width: 34px; height: 34px; border-radius: var(--r1); flex-shrink: 0;
  background: var(--co-dim); border: 1.5px solid rgba(255,77,46,0.3);
  color: var(--co); font-size: .82rem;
  display: flex; align-items: center; justify-content: center;
}
.sb-owner-info { overflow: hidden; min-width: 0; }
.sb-owner-info strong { display: block; font-size: .78rem; color: var(--t1); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sb-owner-info span { font-size: .68rem; color: var(--t3); }
.sidebar.collapsed .sb-owner-info { display: none; }
.sidebar.collapsed .sb-owner { justify-content: center; }
.sb-logout { color: var(--t3); padding: .35rem; border-radius: var(--r1); transition: var(--d); flex-shrink: 0; }
.sb-logout:hover { color: var(--rose); background: var(--rose-d); }

/* Main */
.main {
  flex: 1; margin-left: var(--sb);
  display: flex; flex-direction: column; min-height: 100vh;
  transition: margin-left var(--d);
}
.sidebar.collapsed + .main { margin-left: var(--sb-sm); }

/* Top bar */
.topbar {
  position: sticky; top: 0; z-index: 50;
  display: flex; align-items: center; justify-content: space-between;
  padding: .9rem 1.8rem; min-height: 64px;
  background: var(--surf); border-bottom: 1px solid var(--b1);
}
.topbar-l { display: flex; align-items: center; gap: .9rem; }
.topbar-r { display: flex; align-items: center; gap: .65rem; }
.mob-menu { display: none; color: var(--t2); padding: .35rem; border-radius: var(--r1); }
.page-title {
  font-family: 'Syne', sans-serif; font-size: 1.1rem; font-weight: 700;
  color: var(--t1); letter-spacing: -.02em; line-height: 1.2;
}
.page-sub { font-size: .72rem; color: var(--t3); margin-top: 1px; }

/* Tabs */
.tab { display: none; flex-direction: column; gap: 1.25rem; padding: 1.75rem 1.8rem; animation: tabIn .2s ease; }
.tab.active { display: flex; }
@keyframes tabIn { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:none} }

/* ═══════════════════════════════════════════════
   STATS ROW
═══════════════════════════════════════════════ */
.stats-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 1rem; }

.stat-card {
  background: var(--card); border: 1px solid var(--b1);
  border-radius: var(--r3); padding: 1.4rem 1.5rem;
  position: relative; overflow: hidden; cursor: default;
  transition: border-color var(--d), transform var(--d);
}
.stat-card:hover { border-color: var(--b2); transform: translateY(-2px); }

/* Top colored bar */
.stat-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
}
.stat-card:nth-child(1)::before { background: var(--co); }
.stat-card:nth-child(2)::before { background: var(--mint); }
.stat-card:nth-child(3)::before { background: var(--gold); }
.stat-card:nth-child(4)::before { background: var(--rose); }

.stat-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
.stat-label { font-size: .68rem; font-weight: 600; text-transform: uppercase; letter-spacing: .7px; color: var(--t3); }
.stat-ico { width: 36px; height: 36px; border-radius: var(--r1); display: flex; align-items: center; justify-content: center; font-size: .88rem; }
.stat-ico.coral, .stat-ico.amber  { background: var(--co-dim);  color: var(--co); }
.stat-ico.mint,  .stat-ico.green  { background: var(--mint-d);  color: var(--mint); }
.stat-ico.gold,  .stat-ico.violet { background: var(--gold-d);  color: var(--gold); }
.stat-ico.rose                    { background: var(--rose-d);  color: var(--rose); }
.stat-ico.sky                     { background: var(--sky-d);   color: var(--sky); }

.stat-val {
  font-family: 'Syne', sans-serif; font-size: 2rem; font-weight: 800;
  color: var(--t1); line-height: 1; letter-spacing: -.04em;
}
.stat-hint { font-size: .71rem; color: var(--t3); margin-top: .5rem; }

/* ═══════════════════════════════════════════════
   CARDS
═══════════════════════════════════════════════ */
.card {
  background: var(--card); border: 1px solid var(--b1);
  border-radius: var(--r3); padding: 1.4rem 1.5rem;
}
.card-hd {
  display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.2rem;
}
.card-hd h3 {
  font-family: 'Syne', sans-serif; font-size: .88rem; font-weight: 700;
  color: var(--t1); display: flex; align-items: center; gap: .45rem; letter-spacing: -.01em;
}
.card-hd h3 i { color: var(--co); }
.link-sm { font-size: .72rem; color: var(--t3); display: flex; align-items: center; gap: .3rem; transition: color var(--d); }
.link-sm:hover { color: var(--co); opacity: 1; }
.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }

/* List items */
.list-box { display: flex; flex-direction: column; gap: .4rem; }
.li-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: .7rem .9rem; border-radius: var(--r2);
  background: var(--surf); border: 1px solid var(--b1); transition: var(--d);
}
.li-row:hover { background: var(--hover); border-color: var(--b2); }
.li-left { display: flex; align-items: center; gap: .65rem; }
.li-ico { width: 32px; height: 32px; border-radius: var(--r1); background: var(--co-dim); color: var(--co); display: flex; align-items: center; justify-content: center; font-size: .78rem; flex-shrink: 0; }
.li-name { font-size: .83rem; font-weight: 600; color: var(--t1) !important; }
.li-sub  { font-size: .71rem; color: var(--t3) !important; display: block; }
.li-right { text-align: right; flex-shrink: 0; }
.li-amount { font-family: 'Syne', sans-serif; font-size: .88rem; font-weight: 700; color: var(--t1); }

/* ═══════════════════════════════════════════════
   FORM CONTROLS
═══════════════════════════════════════════════ */
.fg { display: flex; flex-direction: column; gap: .38rem; margin-bottom: .9rem; }
.fg:last-child { margin-bottom: 0; }
.fg-row { display: grid; grid-template-columns: 1fr 1fr; gap: .85rem; }

label { font-size: .77rem; font-weight: 600; color: var(--t2); display: flex; align-items: center; gap: .38rem; }
label i { color: var(--co); font-size: .72rem; }

.fc {
  display: block; width: 100%;
  background: var(--inp) !important;
  border: 1px solid var(--b2);
  border-radius: var(--r2); color: var(--t1) !important;
  padding: .7rem .95rem; font-size: .875rem; font-family: inherit;
  outline: none; transition: border-color var(--d), box-shadow var(--d);
}
.fc:focus {
  border-color: var(--co);
  box-shadow: 0 0 0 3px rgba(255,77,46,0.12);
}
.fc::placeholder { color: var(--t3) !important; }
.fc option { background: var(--card); color: var(--t1); }
.fc:disabled { opacity: .4; cursor: not-allowed; }
textarea.fc { resize: vertical; min-height: 74px; }

/* Autofill — dark background always */
.fc:-webkit-autofill,
.fc:-webkit-autofill:hover,
.fc:-webkit-autofill:focus {
  -webkit-box-shadow: 0 0 0 1000px var(--inp) inset !important;
  -webkit-text-fill-color: var(--t1) !important;
  caret-color: var(--t1);
  transition: background-color 9999s ease 0s;
  border-color: var(--b2) !important;
}

.fc-wrap { position: relative; display: flex; align-items: center; }
.fc-wrap .fc { padding-right: 2.65rem; }
.fc-eye {
  position: absolute; right: .8rem;
  background: none; border: none; outline: none;
  cursor: pointer; z-index: 2;
  color: var(--t3); font-size: .85rem;
  padding: .3rem; line-height: 1;
  display: flex; align-items: center; justify-content: center;
  transition: color var(--d);
}
.fc-eye:hover { color: var(--co); }
.f-hint { font-size: .71rem; color: var(--t3); margin-top: .3rem; }
.muted { color: var(--t3); }

/* ═══════════════════════════════════════════════
   BUTTONS
═══════════════════════════════════════════════ */
.btn {
  display: inline-flex; align-items: center; gap: .45rem;
  padding: .62rem 1.2rem; border-radius: var(--r2);
  font-size: .875rem; font-weight: 600; font-family: inherit;
  cursor: pointer; border: 1px solid transparent;
  transition: all var(--d); white-space: nowrap;
}
.btn:disabled { opacity: .35; cursor: not-allowed; }

.btn-primary { background: var(--co); color: #fff; border-color: var(--co); }
.btn-primary:hover:not(:disabled) { background: var(--co-l); box-shadow: 0 4px 20px var(--co-glo); transform: translateY(-1px); }

.btn-ghost { background: transparent; color: var(--t2); border-color: var(--b2); }
.btn-ghost:hover:not(:disabled) { background: var(--hover); border-color: var(--b3); color: var(--t1); }

.btn-secondary { background: var(--card2); color: var(--t1); border-color: var(--b2); }
.btn-secondary:hover:not(:disabled) { background: var(--hover); }

.btn-danger { background: var(--rose-d); color: var(--rose); border-color: rgba(255,61,107,0.2); }
.btn-danger:hover:not(:disabled) { background: var(--rose); color: #fff; }

.btn-icon { width: 32px; height: 32px; border-radius: var(--r1); display: inline-flex; align-items: center; justify-content: center; color: var(--t3); font-size: .9rem; transition: var(--d); }
.btn-icon:hover { color: var(--t1); background: var(--hover); }
.btn-sm { padding: .35rem .75rem; font-size: .76rem; }
.btn-xs { padding: .22rem .55rem; font-size: .7rem; border-radius: var(--r1); }
.w100 { width: 100%; justify-content: center; }
.btn-text, .btn-loader { display: flex; align-items: center; gap: .4rem; }

/* ═══════════════════════════════════════════════
   TOOLBAR / SEARCH
═══════════════════════════════════════════════ */
.toolbar { display: flex; align-items: center; justify-content: space-between; gap: .9rem; flex-wrap: wrap; }
.toolbar-l, .toolbar-r { display: flex; align-items: center; gap: .65rem; }
.sect-title {
  font-family: 'Syne', sans-serif; font-weight: 700; font-size: .93rem;
  color: var(--t1); letter-spacing: -.01em;
}
.search-box {
  display: flex; align-items: center; gap: .45rem;
  background: var(--card); border: 1px solid var(--b1);
  border-radius: var(--r2); padding: .5rem .85rem; color: var(--t3);
  transition: border-color var(--d);
}
.search-box:focus-within { border-color: var(--co); }
.search-box input { background: none; border: none; outline: none; color: var(--t1); font-size: .875rem; width: 180px; }
.search-box input::placeholder { color: var(--t3); }

/* ═══════════════════════════════════════════════
   PROPERTIES
═══════════════════════════════════════════════ */
.prop-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px,1fr)); gap: 1.1rem; }
.prop-card {
  background: var(--card); border: 1px solid var(--b1);
  border-radius: var(--r3); overflow: hidden; transition: border-color .2s, transform .2s;
}
.prop-card:hover { border-color: rgba(255,77,46,0.3); transform: translateY(-3px); }
.prop-banner {
  height: 72px; position: relative; overflow: hidden;
  border-bottom: 1px solid var(--b1);
  background: var(--card2);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.8rem; color: rgba(255,77,46,0.12);
}
/* Subtle diagonal stripes on banner */
.prop-banner::before {
  content: ''; position: absolute; inset: 0;
  background: repeating-linear-gradient(-45deg, transparent, transparent 12px, rgba(255,77,46,0.025) 12px, rgba(255,77,46,0.025) 24px);
}
.prop-body { padding: 1.1rem; }
.prop-body h3 { font-family: 'Syne', sans-serif; font-size: .9rem; font-weight: 700; margin-bottom: .2rem; letter-spacing: -.01em; }
.prop-addr { font-size: .74rem; color: var(--t3); margin-bottom: .9rem; display: flex; gap: .35rem; align-items: flex-start; line-height: 1.5; }
.prop-addr i { color: var(--co); margin-top: 2px; font-size: .7rem; }
.unit-label { font-size: .67rem; font-weight: 700; color: var(--t3); text-transform: uppercase; letter-spacing: .6px; margin-bottom: .38rem; }
.unit-rows { display: flex; flex-direction: column; gap: .28rem; }
.unit-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: .38rem .65rem; background: var(--surf);
  border-radius: var(--r1); border: 1px solid var(--b1);
}
.unit-item-l strong { font-size: .78rem; font-weight: 600; }
.unit-item-l span  { font-size: .67rem; color: var(--t3); display: block; }
.prop-actions { display: flex; gap: .45rem; margin-top: .85rem; padding-top: .85rem; border-top: 1px solid var(--b1); }

/* ═══════════════════════════════════════════════
   BADGES
═══════════════════════════════════════════════ */
.badge {
  display: inline-flex; align-items: center; padding: .14rem .48rem;
  border-radius: 4px; font-size: .64rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .4px; white-space: nowrap;
}
.badge-occupied, .badge-active   { background: var(--mint-d); color: var(--mint); }
.badge-vacant                    { background: var(--gold-d); color: var(--gold); }
.badge-inactive                  { background: var(--rose-d); color: var(--rose); }
.badge-pending                   { background: var(--gold-d); color: var(--gold); }
.badge-paid                      { background: var(--mint-d); color: var(--mint); }
.badge-overdue                   { background: var(--rose-d); color: var(--rose); }
.badge-in_progress,.badge-in-progress { background: var(--sky-d); color: var(--sky); }
.badge-completed                 { background: var(--mint-d); color: var(--mint); }
.badge-low                       { background: var(--mint-d); color: var(--mint); }
.badge-medium                    { background: var(--gold-d); color: var(--gold); }
.badge-high                      { background: var(--rose-d); color: var(--rose); }
.badge-emergency                 { background: var(--rose-d); color: var(--rose); }
.cnt-badge { background: var(--co-dim); color: var(--co); border-radius: 4px; padding: .12rem .5rem; font-size: .72rem; font-weight: 700; }

/* ═══════════════════════════════════════════════
   TABLE
═══════════════════════════════════════════════ */
.table-wrap { overflow-x: auto; }
.tbl { width: 100%; border-collapse: collapse; font-size: .83rem; }
.tbl th {
  padding: .65rem 1rem; text-align: left;
  font-size: .65rem; font-weight: 700; text-transform: uppercase; letter-spacing: .6px;
  color: var(--t3); border-bottom: 1px solid var(--b1); white-space: nowrap;
}
.tbl td { padding: .82rem 1rem; border-bottom: 1px solid var(--b1); color: var(--t1); vertical-align: middle; }
.tbl tr:last-child td { border-bottom: none; }
.tbl tbody tr:hover { background: rgba(255,255,255,0.015); }
.td-sub { font-size: .71rem; color: var(--t3) !important; display: block; margin-top: 1px; }
.loading-row { padding: 1.2rem; }
.loading-row { padding: 1.2rem; }

/* ═══════════════════════════════════════════════
   ALERTS
═══════════════════════════════════════════════ */
.alert-error {
  background: var(--rose-d); border: 1px solid rgba(255,61,107,0.2);
  border-left: 3px solid var(--rose);
  border-radius: var(--r2); padding: .75rem 1rem;
  font-size: .82rem; color: var(--rose); line-height: 1.55; margin-bottom: .9rem;
}
.alert-success {
  background: var(--mint-d); border: 1px solid rgba(0,201,167,0.2);
  border-left: 3px solid var(--mint);
  border-radius: var(--r2); padding: .75rem 1rem;
  font-size: .82rem; color: var(--mint); margin-bottom: .9rem;
}

/* ═══════════════════════════════════════════════
   BILLING
═══════════════════════════════════════════════ */
.billing-grid { display: grid; grid-template-columns: 300px 1fr; gap: 1.1rem; align-items: flex-start; }

/* ═══════════════════════════════════════════════
   MAINTENANCE
═══════════════════════════════════════════════ */
.maint-summary { display: grid; grid-template-columns: repeat(3,1fr); gap: .75rem; padding: 1rem 1.3rem; }
.maint-stat { text-align: center; display: flex; flex-direction: column; align-items: center; gap: .15rem; }
.maint-n { font-family: 'Syne', sans-serif; font-size: 1.65rem; font-weight: 800; color: var(--t1); letter-spacing: -.04em; }
.maint-n.red   { color: var(--rose); }
.maint-n.amber { color: var(--gold); }
.maint-stat span { font-size: .7rem; color: var(--t3); text-transform: uppercase; letter-spacing: .5px; font-weight: 600; }

.tickets { display: flex; flex-direction: column; gap: .7rem; }
.ticket-card {
  background: var(--surf); border: 1px solid var(--b1);
  border-radius: var(--r2); padding: 1rem 1.25rem; transition: border-color var(--d);
}
.ticket-card:hover { border-color: var(--b2); }
.ticket-hd { display: flex; align-items: flex-start; justify-content: space-between; gap: .7rem; margin-bottom: .35rem; }
.ticket-hd h4 { font-size: .87rem; font-weight: 600; color: var(--t1); line-height: 1.4; }
.ticket-desc { font-size: .8rem; color: var(--t2); line-height: 1.65; margin-bottom: .7rem; }
.ticket-ft { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .5rem; padding-top: .7rem; border-top: 1px solid var(--b1); font-size: .71rem; color: var(--t3); }
.ticket-ft-l { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
.ticket-ft-r { display: flex; align-items: center; gap: .45rem; }

.chips { display: flex; flex-wrap: wrap; gap: .45rem; }
.chip { padding: .28rem .75rem; border-radius: var(--r1); font-size: .74rem; font-weight: 600; text-transform: uppercase; letter-spacing: .4px; background: var(--inp); border: 1px solid var(--b1); color: var(--t3); cursor: pointer; transition: var(--d); }
.chip:hover { color: var(--t1); border-color: var(--b2); }
.chip.active { background: var(--co-dim); border-color: rgba(255,77,46,0.3); color: var(--co); }

/* ═══════════════════════════════════════════════
   SETTINGS
═══════════════════════════════════════════════ */
.settings-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; align-items: flex-start; }
.span2 { grid-column: 1/-1; }
.info-rows { margin-top: .75rem; }
.info-row { display: flex; align-items: center; justify-content: space-between; padding: .72rem 0; border-bottom: 1px solid var(--b1); font-size: .83rem; }
.info-row:last-child { border-bottom: none; }
.info-row span { color: var(--t3); }
.green-text { color: var(--mint); }

/* ═══════════════════════════════════════════════
   MODALS
═══════════════════════════════════════════════ */
.modal { display: none; position: fixed; inset: 0; z-index: 1000; align-items: center; justify-content: center; padding: 1rem; }
.modal.active { display: flex; }
.modal-bg { position: absolute; inset: 0; background: rgba(0,0,0,.72); backdrop-filter: blur(8px); }
.modal-box {
  position: relative; background: var(--card); border: 1px solid var(--b2);
  border-radius: var(--r4); width: 100%; max-width: 480px; max-height: 90vh; overflow-y: auto;
  box-shadow: 0 24px 80px rgba(0,0,0,.75); animation: mIn .22s cubic-bezier(.34,1.56,.64,1);
}
.modal-lg { max-width: 600px; }
@keyframes mIn { from{opacity:0;transform:scale(.91) translateY(16px)} to{opacity:1;transform:none} }
.modal-hd {
  display: flex; align-items: center; justify-content: space-between;
  padding: 1.35rem 1.5rem .9rem; border-bottom: 1px solid var(--b1);
}
.modal-hd h2 { font-family: 'Syne', sans-serif; font-size: .92rem; font-weight: 700; display: flex; align-items: center; gap: .45rem; letter-spacing: -.01em; }
.modal-hd h2 i { color: var(--co); }
.modal-body { padding: 1.35rem 1.5rem; }
.modal-ft { display: flex; align-items: center; justify-content: flex-end; gap: .65rem; padding: .9rem 1.5rem 1.35rem; border-top: 1px solid var(--b1); }

/* ═══════════════════════════════════════════════
   TOASTS
═══════════════════════════════════════════════ */
.toast-wrap { position: fixed; bottom: 1.4rem; right: 1.4rem; z-index: 9999; display: flex; flex-direction: column; gap: .55rem; pointer-events: none; }
.toast {
  display: flex; align-items: flex-start; gap: .65rem; padding: .85rem 1rem;
  background: var(--card); border: 1px solid var(--b2);
  border-radius: var(--r2); pointer-events: all; min-width: 255px; max-width: 340px;
  box-shadow: 0 8px 30px rgba(0,0,0,.6); animation: tIn .26s cubic-bezier(.34,1.56,.64,1);
}
.toast.success { border-left: 3px solid var(--mint); }
.toast.error   { border-left: 3px solid var(--rose); }
.toast.info    { border-left: 3px solid var(--co); }
@keyframes tIn { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:none} }
.toast-icon { font-size: .92rem; flex-shrink: 0; margin-top: 2px; }
.toast.success .toast-icon { color: var(--mint); }
.toast.error   .toast-icon { color: var(--rose); }
.toast.info    .toast-icon { color: var(--co); }
.toast-title { font-size: .82rem; font-weight: 700; color: var(--t1); }
.toast-msg   { font-size: .74rem; color: var(--t2); margin-top: 1px; }

/* ═══════════════════════════════════════════════
   LOADING / EMPTY / UTILS
═══════════════════════════════════════════════ */
.pulse {
  background: linear-gradient(90deg, var(--card) 25%, var(--hover) 50%, var(--card) 75%);
  background-size: 200% 100%; animation: shimmer 1.6s infinite;
  border-radius: var(--r2); height: 44px;
}
.pulse.h80  { height: 80px; }
.pulse.h200 { height: 200px; }
@keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }
.mt8 { margin-top: 8px; }

.empty-state {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 2.75rem 1rem; text-align: center; color: var(--t3); gap: .5rem;
}
.empty-state i { font-size: 2rem; opacity: .15; }
.empty-state h3 { font-size: .88rem; font-weight: 600; color: var(--t2); }
.empty-state p  { font-size: .76rem; max-width: 230px; }

/* ═══════════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════════ */
@media (max-width: 1100px) {
  .stats-row { grid-template-columns: repeat(2,1fr); }
  .billing-grid { grid-template-columns: 1fr; }
}
@media (max-width: 900px) {
  .two-col { grid-template-columns: 1fr; }
  .settings-grid { grid-template-columns: 1fr; }
  .span2 { grid-column: auto; }
}
@media (max-width: 768px) {
  .auth-wrap { grid-template-columns: 1fr; max-width: 420px; }
  .auth-brand { display: none; }
  .sidebar { transform: translateX(-100%); transition: transform var(--d); }
  .sidebar.mob-open { transform: translateX(0); }
  .main { margin-left: 0 !important; }
  .mob-menu { display: flex !important; }
  .topbar, .tab { padding-left: 1rem; padding-right: 1rem; }
  .fg-row { grid-template-columns: 1fr; }
  .prop-grid { grid-template-columns: 1fr; }
  .toolbar { flex-direction: column; align-items: flex-start; }
}
@media (max-width: 480px) {
  .stats-row { grid-template-columns: 1fr; }
}

/* ═══════════════════════════════════════════════
   NAV BADGE
═══════════════════════════════════════════════ */
.nav-badge {
  background: var(--rose); color: #fff; font-size: .6rem; font-weight: 700;
  min-width: 17px; height: 17px; border-radius: 9px; padding: 0 .3rem;
  display: inline-flex; align-items: center; justify-content: center;
  margin-left: auto; flex-shrink: 0; letter-spacing: 0;
}
.sidebar.collapsed .nav-badge { position: absolute; top: 6px; right: 6px; margin: 0; }

/* ═══════════════════════════════════════════════
   OCCUPANCY PROGRESS BAR
═══════════════════════════════════════════════ */
.stat-prog-wrap {
  margin-top: .6rem; height: 4px; background: var(--b1); border-radius: 4px; overflow: hidden;
}
.stat-prog {
  height: 100%; border-radius: 4px; background: linear-gradient(90deg, var(--mint), var(--sky));
  transition: width .6s cubic-bezier(.4,0,.2,1); width: 0%;
}

/* ═══════════════════════════════════════════════
   REVENUE BAR CHART
═══════════════════════════════════════════════ */
.rev-bar-wrap {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px;
  min-width: 0; cursor: default;
}
.rev-bar {
  width: 100%; max-width: 28px; border-radius: 3px 3px 0 0;
  background: linear-gradient(180deg, var(--co), rgba(255,77,46,.4));
  transition: height .5s ease; position: relative;
}
.rev-bar:hover { background: linear-gradient(180deg, var(--co-l), var(--co)); }
.rev-bar-label { font-size: .6rem; color: var(--t3); text-align: center; white-space: nowrap; }

/* ═══════════════════════════════════════════════
   BILLING SUMMARY BAR
═══════════════════════════════════════════════ */
.billing-summary {
  display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; margin-bottom: 1.1rem;
}
.bsumm-card {
  background: var(--card); border: 1px solid var(--b1); border-radius: var(--r2);
  padding: 1rem 1.2rem; display: flex; align-items: center; gap: .9rem;
}
.bsumm-ico { width: 36px; height: 36px; border-radius: var(--r1); display: flex; align-items: center; justify-content: center; font-size: .9rem; flex-shrink: 0; }
.bsumm-val { font-family: 'Syne', sans-serif; font-size: 1.1rem; font-weight: 800; line-height: 1; }
.bsumm-lbl { font-size: .68rem; color: var(--t3); text-transform: uppercase; letter-spacing: .5px; margin-top: .2rem; }

/* ═══════════════════════════════════════════════
   TICKET PRIORITY BORDERS
═══════════════════════════════════════════════ */
.ticket-card[data-priority="HIGH"],
.ticket-card[data-priority="EMERGENCY"] { border-left: 3px solid var(--rose); }
.ticket-card[data-priority="MEDIUM"]    { border-left: 3px solid var(--gold); }
.ticket-card[data-priority="LOW"]       { border-left: 3px solid var(--mint); }

/* ═══════════════════════════════════════════════
   LEASE EXPIRY BADGES
═══════════════════════════════════════════════ */
.expiry-warning { font-size: .68rem; font-weight: 700; padding: .12rem .45rem; border-radius: 4px; }
.expiry-critical { background: var(--rose-d); color: var(--rose); }
.expiry-soon     { background: var(--gold-d);  color: var(--gold); }
.expiry-ok       { color: var(--t3); }

/* PROPERTY CARD occupancy bar */
.prop-occ-bar {
  display: flex; align-items: center; gap: .5rem; margin: .5rem 0 .75rem;
}
.prop-occ-track {
  flex: 1; height: 5px; background: var(--b1); border-radius: 4px; overflow: hidden;
}
.prop-occ-fill {
  height: 100%; border-radius: 4px;
  background: linear-gradient(90deg, var(--mint), var(--sky));
}
.prop-occ-txt { font-size: .68rem; color: var(--t3); white-space: nowrap; }

/* ═══════════════════════════════════════════════
   DETAILED INVOICE MODAL & PRINT STYLES
═══════════════════════════════════════════════ */
.invoice-header { display: flex; justify-content: space-between; border-bottom: 1px solid var(--b1); padding-bottom: 1rem; margin-bottom: 1.5rem; }
.invoice-brand { display: flex; align-items: center; gap: 1rem; }
.invoice-brand i { font-size: 2rem; color: var(--co); }
.invoice-brand h2 { font-size: 1.2rem; font-family: 'Syne', sans-serif; margin-bottom: 0; }
.invoice-meta { text-align: right; }
.invoice-meta h3 { font-size: 1.5rem; letter-spacing: 2px; color: var(--t3); margin: 0 0 .5rem 0; font-family: 'Syne', sans-serif; }
.invoice-meta div { font-size: .85rem; margin-bottom: .25rem; }
.invoice-parties { display: flex; justify-content: space-between; margin-bottom: 2rem; background: var(--b1); padding: 1.2rem; border-radius: var(--r2); }
.invoice-total { display: flex; justify-content: space-between; align-items: center; background: var(--co-dim); color: var(--co); padding: 1.2rem; border-radius: var(--r2); margin-top: 1.5rem; font-size: 1.2rem; }
.invoice-total strong { font-family: 'Syne', sans-serif; font-size: 1.8rem; font-weight: 800; }

@media print {
  body * { visibility: hidden; }
  .modal.active, .modal.active * { visibility: visible; }
  .modal.active { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: block; padding: 0; }
  .modal-box { width: 100%; max-width: none; box-shadow: none; border: none; padding: 0; margin: 0; border-radius: 0; background: #fff !important; }
  .no-print, .modal-bg { display: none !important; }
  .modal-body { max-height: none; overflow: visible; padding: 2rem; color: #000 !important; }
  /* Override dark mode colors for print */
  .invoice-parties, .invoice-total { background: #f5f5f5 !important; border: 1px solid #ddd; }
  .invoice-total, .invoice-brand h2, .invoice-brand i { color: #000 !important; }
  .tbl th, .tbl td { border-bottom: 1px solid #ddd !important; color: #000 !important; }
  .tbl th { color: #666 !important; }
  .f-lbl, .invoice-meta h3 { color: #666 !important; }
}

@media (max-width: 900px) { .billing-summary { grid-template-columns: 1fr 1fr; } }
@media (max-width: 540px) { .billing-summary { grid-template-columns: 1fr; } }
